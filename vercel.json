{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/ppc/pipeline.html"
    },
    {
      "source": "/index.html",
      "destination": "/ppc/pipeline.html"
    },
    {
      "source": "/js/:path*",
      "destination": "/ppc/js/:path*"
    },
    {
      "source": "/css/:path*",
      "destination": "/ppc/css/:path*"
    },
    {
      "source": "/recovery-import.html",
      "destination": "/ppc/recovery-import.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/ppc/api/pipeline/:path*"
    }
  ],
  "outputDirectory": ".next",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "crons": [
    {
      "path": "/ppc/api/library/maintenance",
      "schedule": "30 16 * * *"
    }
  ]
}
