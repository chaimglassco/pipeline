# Public navigation only; defaults to the canonical Pipeline origin.
NEXT_PUBLIC_PIPELINE_ORIGIN=

# Server-to-server Pipeline authentication; defaults to the canonical Pipeline origin.
PIPELINE_AUTH_ORIGIN=

# Optional non-secret Vercel Connect and MCP overrides.
SCALE_INSIGHTS_CONNECTOR=mcp.scaleinsights.com/glassco-scale-insights
SCALE_INSIGHTS_MCP_URL=https://mcp.scaleinsights.com/mcp

# Local-only credential for the dashboard AI assistant. Vercel deployments use project OIDC instead.
AI_GATEWAY_API_KEY=
